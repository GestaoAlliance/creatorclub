# Copie para .env e preencha. Nunca commitar .env.

# Banco usado pelo app (e pelas migrações, localmente).
# Local: postgresql://creator:creator@localhost:5432/creator_club_dev
# Supabase: transaction pooler, porta 6543 (Connect → Direct → Transaction pooler).
DATABASE_URL=""

# Só na Vercel (Production): conexão das migrações, session pooler, porta 5432.
# Usada por scripts/vercel-build.mjs antes do build. Localmente pode ficar vazia.
DIRECT_URL=""

# Banco só para testes de integração. Cada execução cria e apaga um schema próprio nele.
TEST_DATABASE_URL="postgresql://creator:creator@localhost:5432/creator_club_test"

# Supabase Auth (públicas: vão para o navegador). Na Vercel: Production e Preview.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Chave secreta do Supabase (Settings → API Keys → Secret key). SÓ no servidor; nunca NEXT_PUBLIC_.
# Usada para criar o login de quem aceita convite. Na Vercel: Production e Preview, tipo Secret.
SUPABASE_SECRET_KEY=""

# Segredo das chamadas agendadas (pg_cron → POST /api/jobs/run), D-CRON. Mínimo 32 caracteres.
# Gerar com: openssl rand -base64 48. Na Vercel: Production, tipo Secret. O mesmo valor vai para o
# Supabase Vault (nunca no repositório).
JOBS_SECRET=""

# Chave que cifra token e segredo do webhook do Shopify no banco (D-SHOPAPP): 32 bytes em base64.
# Gerar com: openssl rand -base64 32. Na Vercel: Production e Preview, tipo Secret. Trocar a chave exige
# gravar de novo as credenciais das lojas.
INTEGRATION_ENC_KEY=""

# E-mail (D-EMAIL, D-EMAILFROM): Resend com o domínio do projeto. Sem as duas, o convite fica só no link na tela.
# Na Vercel: Production, tipo Secret (a chave). EMAIL_DOMAIN só o domínio (ex.: creatorclub.app.br): cada marca
# manda da própria caixa (botanika@, vermefree@, revita@).
RESEND_API_KEY=
EMAIL_DOMAIN=

# D-DOMAIN: endereço público do site (produção: https://creatorclub.app.br). Todo link sai com ele e as telas
# abertas pelo endereço antigo da Vercel vão para ele. Vazio (local, prévias) = o endereço da página.
APP_URL=

# M2.2 (D-WHATSAPP): avisos à creator pelo WhatsApp da marca. Endereço de produção do fluxo
# "[Creator Club] Avisos WhatsApp" no n8n e a senha (32+ caracteres) que o fluxo confere. Vazio = sem WhatsApp.
N8N_NOTICES_URL=
N8N_NOTICES_SECRET=
