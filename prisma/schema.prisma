// Creator Club v2 — schema do núcleo (lançamento 1).
//
// Regras que valem para todo o schema:
//  - Dinheiro em centavos (Int) e taxas em pontos-base (1500 = 15%). Nunca Float.
//  - Nada financeiro é apagado: relações com onDelete: Restrict; status no lugar de exclusão.
//  - Tudo que pertence a uma marca carrega brandId. Relações financeiras usam FK composta
//    (id, brandId) para impedir misturar registros de marcas diferentes.
//  - Travas que o Prisma não expressa (CHECKs, exclusão de sobreposição, extrato só de
//    inserção, um saque aberto por creator, unicidade com NULL) estão em SQL na migração
//    prisma/migrations/*_core/migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Marca e integrações ─────────────────────────────

model Brand {
  id                        String              @id @default(uuid())
  slug                      String              @unique
  name                      String
  enabled                   Boolean             @default(false)
  timezone                  String              @default("America/Sao_Paulo")
  currency                  String              @default("BRL")
  storeUrl                  String?
  primaryColor              String              @default("#18181B") // D-BRANDCOLOR; só #RRGGBB (Brand_colors_hex)
  secondaryColor            String?
  defaultCommissionBps      Int                 @default(1500) // DECISÃO-ABERTA: D-RATE
  defaultDiscountBps        Int                 @default(500)
  withdrawalMinCents        Int                 @default(1) // D-CONTRACT: sem mínimo por pedido (o mínimo é de vendas no mês)
  withdrawalWindowStartDay  Int                 @default(1) // D-CONTRACT: NF do dia 1 ao 10, pagamento até o dia 15
  withdrawalWindowEndDay    Int                 @default(10)
  commissionHoldDays        Int                 @default(7) // só informativo desde D-CONTRACT (a liberação é no fechamento do mês)
  /// D-CONTRACT: mínimo acumulado para liberar a comissão no fechamento do mês (vendas ou comissão, por `releaseBasis`).
  releaseMinCents           Int                 @default(30000) // D-MIN300: R$ 300 em vendas; Botanika R$ 100 de comissão (D-MIN100)
  releaseMinPrescriberCents Int                 @default(30000)
  /// D-MIN100: o mínimo conta as vendas (padrão) ou a comissão acumulada (Botanika).
  releaseBasis              ReleaseBasis        @default(SALES)
  /// D-TIERKIT: a partir deste mês (AAAA-MM) os produtos vêm pela tabela mensal de vendas (Botanika, 2026-11);
  /// null = meta de R$ 1.000 em janelas de 45/30 dias (D-GOALKIT).
  monthlyKitFrom            String?
  /// D-NFMAIL: e-mail do financeiro que recebe cada nota fiscal enviada pelas creators (null = não envia).
  financeEmail              String?
  /// D-IDLE45: dias sem venda para avisar a creator (portal e WhatsApp/e-mail); null = sem aviso (Botanika: 45).
  idleNoticeDays            Int?
  /// D-REMESSA: conta da marca no SICOOB para a remessa CNAB 240 de Pix (preenchida em Marcas; nada no código).
  bankConvenio              String?
  bankAgency                String?
  bankAgencyDv              String?
  bankAccount               String?
  bankAccountDv             String?
  /// Último número sequencial de remessa (NSA) gerado pela marca.
  remittanceSeq             Int                 @default(0)
  remittances               PaymentRemittance[]
  nfInstructions            String? // M1.3: observações livres para emitir a nota
  nfServiceCode             String? // M1.3 (D-NFDATA): código do serviço na nota; null = padrão 17.06.01
  nfServiceDescription      String? // M1.3: descrição do serviço na nota; null = padrão
  /// U6 (D-PROSPECT): mensagens prontas da prospecção ({NOME} e {LINK}); null = texto padrão da marca.
  prospectFirstMessage      String?
  prospectProposalMessage   String?
  /// M5.1 (D-SHOPBALANCE): desconto da creator sobre o preço da loja na compra com o saldo (0 = preço da loja).
  shopDiscountBps           Int                 @default(0)
  /// D-D4SIGN: produto sugerido na mensagem de aprovação (escolhido em Marcas); null = mensagem sem a sugestão.
  approvalSuggestion        String?
  whatsappInstance          String? // M2.2 (D-WHATSAPP): instância da Evolution (n8n) que manda os avisos; null = só portal e e-mail
  nfTakerDocument           String? // D-NF: CNPJ do tomador da nota fiscal da creator
  legalName                 String? // razão social (recibo de pessoa física, D-PFRECEIPT)
  legacyId                  String?             @unique
  /// D-ARCHIVE: marca arquivada some de todas as telas (nada é apagado).
  archivedAt                DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  integrations       BrandIntegration[]
  roleGrants         RoleGrant[]
  staffInvites       StaffInvite[]
  creators           Creator[]
  commissionPolicies CommissionPolicy[]
  coupons            Coupon[]
  couponAssignments  CouponAssignment[]
  orders             Order[]
  orderLines         OrderLine[]
  attributions       OrderAttribution[]
  ledgerEntries      LedgerEntry[]
  withdrawals        Withdrawal[]
  files              File[]
  webhookEvents      WebhookEvent[]
  jobs               Job[]
  syncRuns           SyncRun[]
  auditLogs          AuditLog[]
  clicks             Click[]
  products           Product[]
  shipments          Shipment[]
  termsVersions      TermsVersion[]
  applications       CreatorApplication[]
  termsAcceptances   TermsAcceptance[]
  contractDocuments  ContractDocument[]
  contractSignatures ContractSignature[]
  contractRequests   ContractRequest[]
  notifications      Notification[]
  noticeRuns         NoticeRun[]
  actionsDone        ActionDone[]
  commissionReleases CommissionRelease[]
  monthClosings      MonthClosing[]
  legacyPayments     LegacyPayment[]
  contractTemplates  ContractTemplate[]
  kitGrants          KitGrant[]
  hunterLinks        HunterLink[]
  hunterClicks       HunterClick[]
  formLinks          FormLink[]
  ugcVideos          UgcVideo[]
  sheetSyncs         SheetSync[]
  sheetSyncIssues    SheetSyncIssue[]
  creatorNotes       CreatorNote[]
  creatorTags        CreatorTag[]
  assets             BrandAsset[]
  campaigns          Campaign[]
  campaignEntries    CampaignEntry[]
  campaignPrizes     CampaignPrize[]
  creatorPosts       CreatorPost[]
  prospects          Prospect[]
}

enum IntegrationKind {
  SHOPIFY
  AUTENTIQUE
  WHATSAPP
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

/// Credenciais por marca. Segredos sempre cifrados pela aplicação (AES-256-GCM) com chave fora do banco.
model BrandIntegration {
  id              String            @id @default(uuid())
  brandId         String
  kind            IntegrationKind
  status          IntegrationStatus @default(DISCONNECTED)
  externalId      String? // ex.: botanika-brasil.myshopify.com
  secretEncrypted String?
  scopes          String?
  apiVersion      String?
  lastSyncAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, kind])
}

// ───────────────────────────── Pessoas e acesso ─────────────────────────────

/// Pessoa que faz login (equipe ou creator). id = id do usuário no Supabase Auth.
model User {
  id         String    @id
  email      String    @unique
  name       String
  phone      String? // telefone da pessoa da equipe (ex.: hunter), opcional
  disabledAt DateTime?
  /// M4.4b (D-ACCESS): último acesso ao sistema (painel ou portal), gravado no máximo uma vez por hora.
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  roleGrants     RoleGrant[]
  creatorAccount CreatorAccount?
  hunterLinks    HunterLink[]
  prospects      Prospect[]
  creatorNotes   CreatorNote[]
}

enum StaffRole {
  SUPER_ADMIN
  GESTAO
  ENVIO
  PAGAMENTO
  HUNTER
  TIKTOK // D-TIKTOKLIST: só a lista do TikTok
  VIEWER // D-VIEWER: só leitura (acompanhamento da marca, sem mudar nada)
}

/// Papel de alguém da equipe numa marca. brandId nulo = todas as marcas (só SUPER_ADMIN).
/// Papel global (brandId nulo) único por pessoa: índice parcial na migração.
model RoleGrant {
  id        String    @id @default(uuid())
  userId    String
  brandId   String?
  role      StaffRole
  createdAt DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([userId, brandId, role])
  @@index([userId])
}

/// Convite de uso único para a equipe (E2.4). Só o hash do token fica no banco; o link é mostrado uma vez.
model StaffInvite {
  id             String    @id @default(uuid())
  /// D-OPENINVITE: nulo = convite aberto (a pessoa digita o próprio e-mail no primeiro acesso); nunca para super admin.
  email          String?
  name           String
  role           StaffRole
  brandId        String? // nulo só para SUPER_ADMIN
  /// D-INVITEBRANDS: outras marcas em que o mesmo papel é dado ao aceitar (ex.: Envio nas três marcas).
  extraBrandIds  String[]  @default([])
  tokenHash      String    @unique
  expiresAt      DateTime
  createdById    String
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  /// D-EMAIL: quando o convite foi enviado por e-mail (nulo = só o link na tela).
  emailedAt      DateTime?
  createdAt      DateTime  @default(now())

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([email])
}

/// Dados da pessoa creator, únicos para todas as marcas.
model CreatorAccount {
  id                String    @id @default(uuid())
  userId            String?   @unique // preenchido quando o convite é aceito
  /// D-ACCESSREQ: quando ela tentou se cadastrar de novo pelo site (já tinha cadastro, sem senha) e pediu o link de acesso.
  accessRequestedAt DateTime?
  name              String
  email             String    @unique
  phone             String?
  cpf               String?
  cnpj              String?
  /// D-PJADDR: regime do CNPJ (MEI, SIMPLES, OUTRO); fora do MEI os produtos vão para o endereço do CNPJ.
  taxRegime         String?
  pixKey            String?
  instagram         String? // sem o @
  tiktok            String? // sem o @ (D-SIGNUPACCOUNT)
  /// Pedido da Vanessa (2026-10-27): respondeu no cadastro se tem TikTok Shop ativo (null = não respondeu).
  tiktokShop        Boolean?
  /// Endereço de entrega (D-SHIPADDR): a creator mantém no portal; cada envio guarda uma cópia.
  addrZip           String?
  addrStreet        String?
  addrNumber        String?
  addrComplement    String?
  addrDistrict      String?
  addrCity          String?
  addrState         String?
  /// M4.2 (D-TAGS): data de nascimento (opcional; cadastro do site, portal ou ficha). Só o dia, sem hora.
  birthDate         DateTime? @db.Date
  /// M4.3 (D-PROFILEFIELDS): perfil opcional — registro profissional (CRN, CRM…), nichos, outras redes, alergias e
  /// restrições (para o kit) e link do mídia kit.
  professionalId    String?
  niches            String[]  @default([])
  youtube           String?
  kwai              String?
  allergies         String?
  mediaKitUrl       String?
  legacyId          String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  creators     Creator[]
  invites      CreatorInvite[]
  applications CreatorApplication[]
}

/// Convite de uso único para a creator entrar no portal (E2.5). Ligado à conta, nunca ao e-mail solto.
model CreatorInvite {
  id             String    @id @default(uuid())
  accountId      String
  tokenHash      String    @unique
  expiresAt      DateTime
  createdById    String
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  /// D-EMAIL: quando o convite foi enviado por e-mail (nulo = só o link na tela).
  emailedAt      DateTime?
  createdAt      DateTime  @default(now())

  account CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
}

enum CreatorCategory {
  INFLUENCER
  UGC
  PRESCRITOR
}

enum CreatorStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
}

/// Participação de uma pessoa numa marca.
model Creator {
  id                      String            @id @default(uuid())
  brandId                 String
  accountId               String
  categories              CreatorCategory[]
  status                  CreatorStatus     @default(ACTIVE)
  activatedAt             DateTime?
  deactivatedAt           DateTime?
  /// D-WDLOCK: saque liberado depois do saldo de abertura aprovado (E6). Nulo = travado.
  withdrawalsUnlockedAt   DateTime?
  withdrawalsUnlockedById String?
  /// D-PFRECEIPT: recebe como pessoa física (recibo no lugar da nota); a equipe marca na ficha.
  receivesAsIndividual    Boolean           @default(false)
  /// D-ANAREVIEW: a Ana conferiu os números (cupons, taxa, vendas) desta creator. Exigido para o saldo de abertura (E6).
  reviewedAt              DateTime?
  reviewedById            String?
  source                  String? // hunter | site | instagram | legacy_import | central
  legacyId                String?
  /// D-CONTRACTVER: modelo de contrato que a creator assinou (mínimo de vendas, faixas de kit, prazo).
  contractTemplateId      String?
  /// D-SIGNCONTRACT: creator aprovada em Candidatas precisa assinar o contrato no portal (o portal fica travado até lá).
  contractRequiredAt      DateTime?
  /// D-CHECKLIST: contrato (vigência; aviso 30 dias antes e no fim, nunca desliga sozinho) e checklist da Central.
  /// Booleano nulo = não informado.
  contractStart           DateTime?         @db.Date
  contractEnd             DateTime?         @db.Date
  contractSigned          Boolean?
  /// D-ARCHIVECREATOR: arquivada some das telas (nada é apagado); o cupom é encerrado na Shopify.
  archivedAt              DateTime?
  archivedById            String?
  /// D-GOALKIT: dia em que começam as janelas da meta de vendas (aprovação; quem já era ativa: 2026-10-27).
  goalStartAt             DateTime?         @db.Date
  /// D-WELCOMEVIDEO: envio inicial "2 produtos + 3 vídeos" combinado na aprovação (vídeos que ela deve à marca); 0 = 1 produto.
  welcomeVideos           Int               @default(0)
  couponRegistered        Boolean?
  followsOnInstagram      Boolean?
  inGroup                 Boolean?
  tagged                  Boolean?
  checklistNote           String?
  /// UGC (até o módulo UGC): pasta dos vídeos, situação dos vídeos e o que foi pedido.
  ugcFolderUrl            String?
  ugcVideoStatus          String?
  ugcOrder                String?
  /// D-UGCVIDEOS: meta de vídeos no ciclo (= período do contrato), definida por creator na ficha.
  ugcVideoGoal            Int?
  notes                   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  account            CreatorAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  commissionPolicies CommissionPolicy[]
  couponAssignments  CouponAssignment[]
  attributions       OrderAttribution[]
  ledgerEntries      LedgerEntry[]
  withdrawals        Withdrawal[]
  shipments          Shipment[]
  termsAcceptances   TermsAcceptance[]
  contractSignatures ContractSignature[]
  contractRequests   ContractRequest[]
  actionsDone        ActionDone[]
  notifications      Notification[]
  commissionReleases CommissionRelease[]
  legacyPayments     LegacyPayment[]
  kitGrants          KitGrant[]
  ugcVideos          UgcVideo[]
  contractTemplate   ContractTemplate?   @relation(fields: [contractTemplateId, brandId], references: [id, brandId], onDelete: Restrict)
  creatorNotes       CreatorNote[]
  tagLinks           CreatorTagLink[]
  campaignEntries    CampaignEntry[]
  campaignPrizes     CampaignPrize[]
  posts              CreatorPost[]

  @@unique([brandId, accountId])
  @@unique([id, brandId])
  @@unique([brandId, legacyId])
  @@index([brandId, status])
}

/// Taxa de comissão com vigência [validFrom, validTo). Sem sobreposição por creator (EXCLUDE na migração).
model CommissionPolicy {
  id            String    @id @default(uuid())
  brandId       String
  creatorId     String
  rateBps       Int
  validFrom     DateTime
  validTo       DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  /// Taxa confirmada pela Ana (D-RATEIMPORT). Sem confirmação, nunca entra em cálculo.
  confirmedAt   DateTime?
  confirmedById String?

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([creatorId, validFrom])
}

// ───────────────────────────── Cupons ─────────────────────────────

enum CouponKind {
  CREATOR
  PROMO
}

/// Todo cupom conhecido da marca. O código é único por marca; a dona muda por CouponAssignment.
model Coupon {
  id             String      @id @default(uuid())
  brandId        String
  code           String // sempre em maiúsculas
  /// null = ainda não classificado pela Ana (D-CLASS); nunca atribui enquanto for null.
  kind           CouponKind?
  classifiedAt   DateTime?
  classifiedById String?
  shopifyId      String?
  discountBps    Int?
  active         Boolean     @default(true)
  legacyId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  brand        Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  assignments  CouponAssignment[]
  attributions OrderAttribution[]
  clicks       Click[]

  @@unique([brandId, code])
  @@unique([id, brandId])
}

/// De quem é um cupom CREATOR em cada período [validFrom, validTo). Sem sobreposição (EXCLUDE na migração).
model CouponAssignment {
  id            String    @id @default(uuid())
  brandId       String
  couponId      String
  creatorId     String
  validFrom     DateTime
  validTo       DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  /// Dona confirmada pela Ana (D-RATEIMPORT). Sem confirmação, o pedido fica pendente.
  confirmedAt   DateTime?
  confirmedById String?

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  coupon  Coupon  @relation(fields: [couponId, brandId], references: [id, brandId], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([couponId, validFrom])
  @@index([creatorId])
}

// ───────────────────────────── Pedidos ─────────────────────────────

/// Espelho do pedido do Shopify. Todos os pedidos da loja, com poucos campos.
model Order {
  id                String    @id @default(uuid())
  brandId           String
  shopifyId         String // gid://shopify/Order/…
  name              String // #1234
  createdAtShop     DateTime
  paidAt            DateTime?
  cancelledAt       DateTime?
  financialStatus   String
  test              Boolean   @default(false)
  taxesIncluded     Boolean?
  subtotalCents     Int // currentSubtotalPriceSet: produtos, com descontos e reembolsos, sem frete
  totalCents        Int
  currency          String    @default("BRL")
  discountCodes     String[]
  /// M3.3 (D-RETURN): id da cliente na Shopify (só com `read_customers`); nada de nome, e-mail ou telefone.
  customerShopifyId String?
  shopifyUpdatedAt  DateTime // versão desta foto do pedido
  syncedAt          DateTime  @default(now())

  brand         Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  lines         OrderLine[]
  attribution   OrderAttribution?
  ledgerEntries LedgerEntry[]

  @@unique([brandId, shopifyId])
  @@unique([id, brandId])
  @@index([brandId, shopifyUpdatedAt])
  @@index([brandId, createdAtShop])
  @@index([brandId, customerShopifyId])
}

model OrderLine {
  id                   String  @id @default(uuid())
  brandId              String
  orderId              String
  shopifyId            String
  title                String
  quantity             Int
  discountedTotalCents Int
  /// M3.2 (D-COST): produto da Shopify da linha (para o custo); linhas antigas sem ele casam pelo nome.
  productShopifyId     String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([orderId, shopifyId])
}

/// A qual creator o pedido pertence. Decidida uma vez (regra first_creator_code_v1).
/// rateBps é preenchido quando o pedido é pago (taxa vigente no pagamento) e não muda depois.
model OrderAttribution {
  id            String   @id @default(uuid())
  brandId       String
  orderId       String   @unique
  creatorId     String
  couponId      String
  rateBps       Int?
  rule          String
  evidenceCodes String[]
  decidedAt     DateTime @default(now())

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  coupon  Coupon  @relation(fields: [couponId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([orderId, brandId])
  @@index([brandId, creatorId])
}

// ───────────────────────────── Extrato e saques ─────────────────────────────

/// D-MIN100: o que conta para o mínimo de liberação da comissão.
enum ReleaseBasis {
  SALES
  COMMISSION
}

enum LedgerType {
  COMMISSION
  REVERSAL
  WITHDRAWAL
  ADJUSTMENT
  OPENING_BALANCE
  PRIZE // M4.5 (D-CAMPAIGN): prêmio de campanha, disponível na hora
  PURCHASE // M5.1 (D-SHOPBALANCE): compra de produtos com o saldo, lançada quando a Gestão aprova
}

/// Cada centavo que entra ou sai do saldo. Só recebe inserções (trigger na migração).
model LedgerEntry {
  id             String     @id @default(uuid())
  brandId        String
  creatorId      String
  type           LedgerType
  amountCents    Int // com sinal
  orderId        String?
  withdrawalId   String?
  baseCents      Int?
  rateBps        Int?
  availableAt    DateTime
  idempotencyKey String     @unique
  note           String?
  createdById    String?
  createdAt      DateTime   @default(now())

  brand      Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator    Creator        @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  order      Order?         @relation(fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)
  withdrawal Withdrawal?    @relation(fields: [withdrawalId, brandId], references: [id, brandId], onDelete: Restrict)
  prize      CampaignPrize?

  @@index([brandId, creatorId, createdAt])
  @@index([orderId])
}

enum PaymentMethod {
  NF_PIX
  ALELO
  RECEIPT_PIX // D-PFRECEIPT: pessoa física, recibo aceito no portal + Pix
}

enum NfCheckStatus {
  OK
  MANUAL
}

enum WithdrawalStatus {
  REQUESTED
  /// M1.1 (D-WDAPPROVE): a Gestão aprovou; falta o Pagamento fazer o Pix. Continua em aberto (reserva o saldo).
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

/// Pedido de saque. No máximo um REQUESTED por creator (índice parcial na migração).
model Withdrawal {
  id             String           @id @default(uuid())
  brandId        String
  creatorId      String
  amountCents    Int
  method         PaymentMethod    @default(NF_PIX)
  status         WithdrawalStatus @default(REQUESTED)
  nfFileId       String?
  nfAccessKey    String? // D-NFCHECK: chave de acesso da NFS-e (50 dígitos); uma nota vale para um saque só
  nfCheck        NfCheckStatus? // D-NFCHECK: OK = conferida pelo sistema; MANUAL = o Pagamento confere
  idempotencyKey String           @unique
  requestedAt    DateTime         @default(now())
  decidedAt      DateTime?
  decidedById    String?
  /// M1.1 (D-WDAPPROVE): quem (Gestão) e quando aprovou para o Pagamento pagar.
  approvedAt     DateTime?
  approvedById   String?
  note           String?
  /// D-REMESSA: remessa SICOOB em que o saque foi enviado ao banco (null = ainda não enviado).
  remittanceId   String?
  /// D-RETORNO: o que o retorno do SICOOB disse da última remessa (null = nada lido ainda; pago vira status PAID).
  bankResult     BankResult?
  bankNote       String?
  bankAt         DateTime?

  brand         Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator       Creator            @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  nfFile        File?              @relation(fields: [nfFileId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]
  receipt       WithdrawalReceipt?
  remittance    PaymentRemittance? @relation(fields: [remittanceId], references: [id], onDelete: Restrict)

  @@unique([id, brandId])
  @@index([brandId, status])
  @@index([creatorId])
}

/// D-RETORNO: resultado do saque no retorno do banco (agendado, pendente de assinatura ou recusado).
enum BankResult {
  SCHEDULED
  PENDING
  REJECTED
}

/// D-REMESSA: arquivo de remessa CNAB 240 (Pix) gerado para o SICOOB. Só recebe inserções.
model PaymentRemittance {
  id          String   @id @default(uuid())
  brandId     String
  nsa         Int
  payDay      DateTime @db.Date
  count       Int
  totalCents  Int
  sha256      String
  createdById String
  createdAt   DateTime @default(now())

  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  withdrawals Withdrawal[]

  @@unique([brandId, nsa])
}

/// D-PFRECEIPT: recibo da creator pessoa física, aceito no portal no lugar da nota. Só recebe inserções.
model WithdrawalReceipt {
  id           String   @id @default(uuid())
  brandId      String
  withdrawalId String   @unique
  userId       String
  fullName     String
  cpf          String
  body         String // texto do recibo como a creator viu
  ip           String?
  userAgent    String?
  acceptedAt   DateTime @default(now())

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
}

/// Arquivo no Storage privado (NF, contrato, vídeo UGC).
model File {
  id           String   @id @default(uuid())
  brandId      String
  bucket       String
  path         String
  mime         String
  sizeBytes    Int
  sha256       String
  uploadedById String?
  createdAt    DateTime @default(now())

  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  withdrawals Withdrawal[]

  @@unique([bucket, path])
}

// ───────────────────────────── Operação ─────────────────────────────

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

/// Todo webhook recebido, gravado antes de responder. X-Shopify-Webhook-Id repetido é ignorado.
model WebhookEvent {
  id          String        @id @default(uuid())
  brandId     String
  topic       String
  webhookId   String
  resourceId  String?
  payloadHash String
  status      WebhookStatus @default(RECEIVED)
  attempts    Int           @default(0)
  error       String?
  receivedAt  DateTime      @default(now())
  processedAt DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, webhookId])
  @@index([status, receivedAt])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Fila de trabalho no Postgres (o webhook grava evento + job na mesma transação).
model Job {
  id          String    @id @default(uuid())
  brandId     String?
  type        String
  payload     Json
  dedupeKey   String?   @unique
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(8)
  runAt       DateTime  @default(now())
  lockedUntil DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([status, runAt])
}

/// Histórico de cargas e reconciliações com o Shopify.
model SyncRun {
  id          String    @id @default(uuid())
  brandId     String
  kind        String // incremental | nightly | backfill
  cursor      DateTime?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  ordersSeen  Int       @default(0)
  ordersFixed Int       @default(0)
  error       String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId, startedAt])
}

enum ActorType {
  USER
  SYSTEM
  WEBHOOK
  JOB
}

/// Quem mudou o quê. Só recebe inserções (trigger na migração).
model AuditLog {
  id        String    @id @default(uuid())
  brandId   String?
  actorType ActorType
  actorId   String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime  @default(now())

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId, createdAt])
  @@index([entity, entityId])
}

/// Clique no link de afiliado /r/<marca>/<cupom>.
model Click {
  id        String   @id @default(uuid())
  brandId   String
  couponId  String
  ipHash    String?
  userAgent String?
  referrer  String?
  landing   String?
  createdAt DateTime @default(now())

  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  coupon Coupon @relation(fields: [couponId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([couponId, createdAt])
}

// ───────────────────────────── Envios de produtos à creator (E7.8) ─────────────────────────────

/// Produto da loja (catálogo da Shopify), para escolher o que vai em cada envio.
model Product {
  id           String    @id @default(uuid())
  brandId      String
  shopifyId    String
  title        String
  active       Boolean   @default(true)
  /// M3.2 (D-COST): custo unitário (primeira variante) lido da Shopify com `read_inventory`; null = sem custo cadastrado.
  costCents    Int?
  costSyncedAt DateTime?
  /// M5.1 (D-SHOPBALANCE): preço de venda da primeira variante na Shopify (catálogo diário); null = sem preço ainda.
  priceCents   Int?
  /// D-KITOPTIONS: produto que a creator pode escolher no portal (aba Pedidos). Marca sem nenhum marcado: todos os ativos.
  kitOption    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  brand Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  items ShipmentItem[]

  @@unique([brandId, shopifyId])
  @@unique([id, brandId])
}

enum ShipmentStatus {
  AWAITING_APPROVAL // pedido da creator (kit) esperando a aprovação da Gestão (D-KITAPPROVAL)
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Envio de produtos à creator (D-SHIPMENTS). Endereço copiado no momento do envio; situação com datas coerentes
/// (travas na migração). Nada é apagado: cancelar é situação.
model Shipment {
  id            String         @id @default(uuid())
  brandId       String
  creatorId     String
  status        ShipmentStatus @default(PREPARING)
  note          String?
  address       Json
  carrier       String?
  trackingCode  String?
  /// M3.2 (D-COST): frete pago pelo envio (digitado ao marcar como enviado); null = não informado.
  freightCents  Int?
  /// M5.1 (D-SHOPBALANCE): compra com o saldo — valor reservado enquanto espera a Gestão e lançado no extrato ao aprovar.
  balanceCents  Int?
  createdById   String
  shippedAt     DateTime?
  shippedById   String?
  deliveredAt   DateTime?
  deliveredBy   String? // STAFF | CREATOR
  deliveredById String?
  cancelledAt   DateTime?
  cancelledById String?
  /// D-KITAPPROVAL: quem da Gestão aprovou o pedido da creator (só pedidos que passaram por aprovação).
  approvedAt    DateTime?
  approvedById  String?
  /// D-KITAPPROVAL: motivo quando a Gestão recusa o pedido (o kit volta para ela escolher de novo).
  rejectReason  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  brand   Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator        @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  items   ShipmentItem[]
  kit     KitGrant?

  @@unique([id, brandId])
  @@index([brandId, status, createdAt])
  @@index([creatorId, createdAt])
}

model ShipmentItem {
  id         String @id @default(uuid())
  brandId    String
  shipmentId String
  productId  String
  title      String // cópia do nome do produto no envio
  quantity   Int

  shipment Shipment @relation(fields: [shipmentId, brandId], references: [id, brandId], onDelete: Restrict)
  product  Product  @relation(fields: [productId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([shipmentId])
}

// ───────────────────────────── Termo de aceite da creator (P4) ─────────────────────────────

/// Texto do termo por marca, em versões (D-TERMS). Só recebe inserções; texto novo = versão nova = novo aceite.
model TermsVersion {
  id          String   @id @default(uuid())
  brandId     String
  version     Int
  title       String
  body        String
  createdById String
  createdAt   DateTime @default(now())

  brand       Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  acceptances TermsAcceptance[]

  @@unique([brandId, version])
  @@unique([id, brandId])
}

/// Aceite eletrônico do termo: quem, quando, de onde, com nome e CPF digitados. Só recebe inserções.
model TermsAcceptance {
  id             String   @id @default(uuid())
  brandId        String
  creatorId      String
  termsVersionId String
  userId         String
  fullName       String
  cpf            String
  ip             String?
  userAgent      String?
  acceptedAt     DateTime @default(now())

  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator      Creator      @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  termsVersion TermsVersion @relation(fields: [termsVersionId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([creatorId, termsVersionId])
  @@index([termsVersionId])
}

// ───────────────────────────── Candidatas (formulário Hunter) ─────────────────────────────

enum ApplicationStatus {
  NEW
  APPROVED
  REJECTED
}

/// Resposta do formulário de cadastro (D-ONBOARD). Chega pelo script do Google Forms; a equipe aprova (vira creator,
/// cupom, taxa e convite) ou recusa. A resposta original fica em `raw`.
model CreatorApplication {
  id              String            @id @default(uuid())
  brandId         String
  source          String // hunter_form | captacao_form (D-CAPTACAO)
  externalKey     String // id da resposta no Google Forms
  submittedAt     DateTime
  fullName        String
  email           String?
  phone           String?
  instagram       String?
  followers       String?
  niche           String?
  kindAnswer      String? // resposta do "Sou:"
  address         String?
  suggestedCoupon String?
  cpf             String?
  cnpj            String?
  companyName     String?
  pixKey          String?
  storiesViews    String? // D-CAPTACAO: "Quantos visualizações tem seus stories?"
  brandsWanted    String? // D-CAPTACAO: "Tenho interesse em representar:" (Botanika / Botanika e VermeFree)
  collabInterest  String? // D-CAPTACAO: interesse em collab com o perfil da marca (Sim/Não)
  note            String? // observação da equipe (ex.: status da planilha antiga)
  hunterCode      String? // D-HUNTERLINK: "Código de quem te convidou" (vem pré-preenchido pelo link do hunter)
  hunterLinkId    String?
  tiktok          String? // D-SIGNUPACCOUNT
  /// M4.2 (D-TAGS): data de nascimento informada na candidatura (vai para a conta na aprovação).
  birthDate       DateTime?         @db.Date
  /// D-SIGNUPACCOUNT: conta criada no próprio cadastro (com login); a aprovação usa esta conta.
  accountId       String?
  /// D-SIGNUP: inscrição pelo formulário do próprio sistema — quando aceitou o uso dos dados e hash do IP do dia
  /// (só para limitar envios repetidos; o IP em si nunca é gravado).
  consentAt       DateTime?
  ipHash          String?
  raw             Json
  status          ApplicationStatus @default(NEW)
  decidedAt       DateTime?
  decidedById     String?
  decisionNote    String?
  creatorId       String?
  prospects       Prospect[]
  createdAt       DateTime          @default(now())

  brand      Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  hunterLink HunterLink?     @relation(fields: [hunterLinkId], references: [id], onDelete: Restrict)
  account    CreatorAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([brandId, source, externalKey])
  @@index([accountId])
  @@index([brandId, status, submittedAt])
}

/// D-CONTRACT: liberação da comissão no fechamento do mês. Comissões de pedidos pagos até `month` (inclusive) ficam
/// disponíveis para saque. Só é gravada quando as vendas acumuladas desde a liberação anterior atingem o mínimo.
/// Somente inserção.
model CommissionRelease {
  id         String       @id @default(uuid())
  brandId    String
  creatorId  String
  month      String // AAAA-MM
  salesCents Int // acumulado desde a liberação anterior até `month` (vendas ou comissão, conforme `basis`)
  minCents   Int // mínimo vigente no fechamento
  basis      ReleaseBasis @default(SALES) // D-MIN100: o que `salesCents` e `minCents` contam
  releasedAt DateTime     @default(now())

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([creatorId, month])
  @@index([brandId, month])
}

/// D-CONTRACT: fechamento do mês de uma marca já rodado (o worker não refaz).
model MonthClosing {
  id       String   @id @default(uuid())
  brandId  String
  month    String // AAAA-MM
  releases Int
  closedAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, month])
}

/// D-LEGACYPAY: pagamento feito antes do Creator Club, importado da planilha da equipe ("Pagamentos influencers").
/// Só valores (sem Pix nem documento). Serve de evidência e sugere o "já pago" do saldo de abertura. Somente inserção.
model LegacyPayment {
  id           String   @id @default(uuid())
  brandId      String
  creatorId    String
  month        String // AAAA-MM das vendas pagas
  periodLabel  String // como a planilha chama o período (ex.: "23/06 a 31/07")
  salesCents   Int
  rateBps      Int
  amountCents  Int
  source       String // ex.: "planilha-pagamentos"
  sourceRef    String // aba e linha da planilha
  importedAt   DateTime @default(now())
  importedById String

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([brandId, source, sourceRef])
  @@index([creatorId])
}

/// D-CONTRACTVER: versão de contrato de uma marca. Cada creator segue a versão que assinou: mínimo de vendas no mês
/// para liberar a comissão (nulo = sem comissão, ex.: UGC permuta), faixas do kit mensal e prazo.
model ContractTemplate {
  id              String   @id @default(uuid())
  brandId         String
  key             String // ex.: influencer-2026-09
  name            String
  releaseMinCents Int?
  /// Faixas do kit pelas vendas do mês anterior: [{ fromCents, toCents?, products }], em ordem crescente.
  kitTiers        Json     @default("[]")
  months          Int
  /// D-SIGNCONTRACT: qual texto de contrato esta versão usa (INFLUENCER, PRESCRITOR ou UGC).
  documentKind    String   @default("INFLUENCER")
  /// D-WELCOMEKIT: suplementos do início da parceria (escolhidos no portal depois de assinar); 0 = sem kit.
  welcomeProducts Int      @default(0)
  createdAt       DateTime @default(now())

  brand      Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creators   Creator[]
  signatures ContractSignature[]
  requests   ContractRequest[]

  @@unique([brandId, key])
  @@unique([id, brandId])
}

enum KitStatus {
  PENDING // aguardando a creator escolher os produtos
  CHOSEN // envio criado
}

/// D-KIT: kit mensal do contrato. No fechamento do mês, a faixa de vendas do mês (contrato da creator) dá N
/// suplementos; a creator escolhe os produtos no portal e o envio é criado "Preparando". Sem prazo.
model KitGrant {
  id         String    @id @default(uuid())
  brandId    String
  creatorId  String
  /// MONTHLY = kit do mês pelas vendas (D-KIT, até 2026-10); WELCOME = kit de boas-vindas (D-WELCOMEKIT);
  /// GOAL = meta de R$ 1.000 numa janela de 45/30 dias (D-GOALKIT).
  kind       String    @default("MONTHLY")
  month      String // AAAA-MM das vendas (boas-vindas: mês da aprovação; meta: mês em que a janela começa)
  /// D-GOALKIT: número da janela da meta (0 = primeiros 45 dias); D-TIERKIT (MONTHLY): total de produtos do mês
  /// até esta liberação (1 a 4); 0 nos outros tipos.
  window     Int       @default(0)
  salesCents Int
  products   Int
  status     KitStatus @default(PENDING)
  shipmentId String?   @unique
  chosenAt   DateTime?
  createdAt  DateTime  @default(now())

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator  Creator   @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([creatorId, kind, month, window])
  @@index([brandId, status])
}

// ───────────────────────────── Links dos hunters (D-HUNTERLINK) ─────────────────────────────

/// Link de um hunter na marca: `/f/[marca]/[formulario]/[codigo]` abre o formulário com "Código de quem te convidou"
/// pré-preenchido; a candidata chega marcada com quem a trouxe. O código não muda (links já divulgados).
model HunterLink {
  id        String   @id @default(uuid())
  brandId   String
  userId    String
  code      String // só letras minúsculas e números
  createdAt DateTime @default(now())

  brand        Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  clicks       HunterClick[]
  applications CreatorApplication[]

  @@unique([brandId, code])
  @@unique([brandId, userId])
}

/// Clique no link do hunter (só recebe inserções). IP guardado só como hash do dia.
model HunterClick {
  id           String   @id @default(uuid())
  brandId      String
  hunterLinkId String
  form         String // hunter | captacao
  ipHash       String?
  userAgent    String?
  createdAt    DateTime @default(now())

  brand      Brand      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  hunterLink HunterLink @relation(fields: [hunterLinkId], references: [id], onDelete: Restrict)

  @@index([hunterLinkId, createdAt])
}

/// Link pré-preenchido do Google Forms de cada formulário da marca, com CODIGO no lugar do código do hunter.
model FormLink {
  id          String   @id @default(uuid())
  brandId     String
  form        String // hunter | captacao
  urlTemplate String
  updatedById String
  updatedAt   DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, form])
}

/// Vídeo entregue por uma UGC (D-UGCVIDEOS): um registro por vídeo, com o link. Conta na meta do ciclo (período do
/// contrato) pela data de entrega. Nada é apagado: registro errado é retirado (removedAt) e sai da contagem.
model UgcVideo {
  id          String    @id @default(uuid())
  brandId     String
  creatorId   String
  deliveredOn DateTime  @db.Date
  url         String
  product     String?
  createdById String
  createdAt   DateTime  @default(now())
  removedAt   DateTime?
  removedById String?

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([creatorId, deliveredOn])
}

/// D-SIGNCONTRACT: texto do contrato por marca e tipo (INFLUENCER, PRESCRITOR, UGC), em versões que só recebem
/// inserções. Os campos entre chaves duplas ({{NOME}}, {{CUPOM}}...) são preenchidos com os dados de cada creator.
model ContractDocument {
  id          String   @id @default(uuid())
  brandId     String
  kind        String
  version     Int
  title       String
  body        String
  createdById String
  createdAt   DateTime @default(now())

  brand      Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  signatures ContractSignature[]
  requests   ContractRequest[]

  @@unique([brandId, kind, version])
  @@unique([id, brandId])
}

/// Assinatura eletrônica do contrato no portal: o texto preenchido exatamente como foi assinado (e o hash dele),
/// com os dados digitados, data, IP e navegador. Só recebe inserções.
model ContractSignature {
  id                 String   @id @default(uuid())
  brandId            String
  creatorId          String
  contractDocumentId String
  contractTemplateId String
  userId             String
  fullName           String
  cpf                String
  cnpj               String?
  companyName        String?
  address            String
  body               String
  bodySha256         String
  ip                 String?
  userAgent          String?
  signedAt           DateTime @default(now())

  brand            Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator          Creator          @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  contractDocument ContractDocument @relation(fields: [contractDocumentId, brandId], references: [id, brandId], onDelete: Restrict)
  contractTemplate ContractTemplate @relation(fields: [contractTemplateId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([creatorId, contractDocumentId])
  @@index([contractDocumentId])
}

/// U5 (D-NOTICES): aviso para a creator no portal (sininho) e, quando houver remetente, por e-mail. Um aviso por
/// acontecimento: `dedupeKey` não repete para a mesma creator (o worker pode rodar de novo sem duplicar).
model Notification {
  id         String    @id @default(uuid())
  brandId    String
  creatorId  String
  kind       String
  dedupeKey  String
  title      String
  body       String
  href       String?
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  emailedAt  DateTime?
  /// M2.2 (D-WHATSAPP): quando o aviso foi entregue ao n8n para o WhatsApp da creator.
  whatsappAt DateTime?

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([creatorId, dedupeKey])
  @@index([creatorId, createdAt])
}

/// U5b (D-NOTICES): uma rodada de avisos por data por marca e dia (dia de São Paulo); o worker roda a cada minuto.
model NoticeRun {
  id      String   @id @default(uuid())
  brandId String
  day     String // AAAA-MM-DD
  created Int      @default(0)
  ranAt   DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, day])
}

enum ContractRequestStatus {
  SENT // enviado ao Autentique, esperando a assinatura
  SIGNED // assinado pela creator
  REJECTED // recusado pela creator no Autentique
  CANCELLED // cancelado pela equipe (ex.: dado errado, reenviar)
}

/// Contrato enviado para assinatura no Autentique (D-AUTENTIQUE): o texto preenchido (com hash) que foi no PDF, o id do
/// documento lá e a situação. Na aprovação nova, o cupom só é criado na Shopify depois da assinatura (`pendingCoupon*`).
model ContractRequest {
  id                 String                @id @default(uuid())
  brandId            String
  creatorId          String
  contractDocumentId String
  contractTemplateId String
  provider           String                @default("AUTENTIQUE")
  externalId         String                @unique
  sandbox            Boolean               @default(false)
  signerName         String
  signerEmail        String
  body               String
  bodySha256         String
  pendingCouponCode  String?
  pendingDiscountBps Int?
  couponCreatedAt    DateTime?
  /// Pedido do responsável (2026-10-23): convite do portal mandado sozinho depois da assinatura (e-mail e/ou WhatsApp).
  inviteSentAt       DateTime?
  status             ContractRequestStatus @default(SENT)
  sentAt             DateTime              @default(now())
  signedAt           DateTime?
  rejectedAt         DateTime?
  rejectReason       String?
  lastCheckedAt      DateTime?
  lastError          String?
  createdById        String

  brand            Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator          Creator          @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  contractDocument ContractDocument @relation(fields: [contractDocumentId, brandId], references: [id, brandId], onDelete: Restrict)
  contractTemplate ContractTemplate @relation(fields: [contractTemplateId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([brandId, status])
  @@index([creatorId])
}

/// D-SHEETSYNC: hora da última alteração de cada campo sincronizado com as planilhas (gatilho no banco).
model FieldStamp {
  entity    String
  entityId  String
  field     String
  changedAt DateTime
  source    String // SYSTEM | SHEET

  @@id([entity, entityId, field])
}

/// D-SHEETSYNC: planilha ligada de cada marca (última entrada e saída).
model SheetSync {
  brandId      String
  sheet        String // central | envios | pagamentos
  lastPushAt   DateTime?
  lastPullAt   DateTime?
  /// D-SHEETREADONLY: última leitura (creatorId → coluna → texto), para achar as células que mudaram.
  snapshot     Json?
  /// M4.7 (D-SHEETOFF): leitura desligada pelo super admin (a equipe parou de usar a planilha); religar limpa.
  disabledAt   DateTime?
  disabledById String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@id([brandId, sheet])
}

/// D-SHEETSYNC: linha da planilha que não deu para aplicar (a equipe resolve no sistema ou na planilha).
model SheetSyncIssue {
  id        String   @id @default(uuid())
  brandId   String
  sheet     String
  tab       String
  row       Int
  message   String
  seenAt    DateTime @default(now())
  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, sheet, tab, row, message])
  @@index([brandId, seenAt])
}

/// M0.2: observação da equipe na ficha da creator (só a equipe vê). Somente inserção, como o extrato: corrigir = nova
/// observação. Entra na linha do tempo da ficha.
model CreatorNote {
  id        String   @id @default(uuid())
  brandId   String
  creatorId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([creatorId, createdAt])
}

/// M2.1 (D-ACTIONS): tarefa da fila de ações marcada como feita. A chave é a ocorrência do alerta (ex.: contrato com
/// fim em tal dia, mínimo de tal mês): a mesma ocorrência não volta; uma nova (outro mês, outro kit) volta à fila.
model ActionDone {
  id        String   @id @default(uuid())
  brandId   String
  creatorId String
  key       String
  doneAt    DateTime @default(now())
  doneById  String

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([brandId, key])
  @@index([creatorId])
}

/// M3.4 (D-WEEKLY): um resumo semanal por marca, semana e pessoa (a chave impede mandar duas vezes).
model SummaryRun {
  id      String   @id @default(uuid())
  key     String   @unique // weekly:<marca>:<segunda AAAA-MM-DD>:<usuário>
  brandId String?
  userId  String
  sentAt  DateTime @default(now())
}

/// M3.4b (D-MCP): aplicativo que pede acesso pelo login OAuth (ex.: o Claude). Cadastro dinâmico (RFC 7591).
model McpClient {
  id           String   @id @default(uuid())
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  codes  McpAuthCode[]
  tokens McpToken[]
}

/// Código de autorização (uso único, 10 min, PKCE S256). Só o hash fica no banco.
model McpAuthCode {
  id            String    @id @default(uuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  client McpClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
}

/// Chave de acesso (1 h) ou de renovação (30 dias, troca a cada uso) de uma pessoa da equipe. Só o hash fica no banco.
model McpToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  kind       String // ACCESS | REFRESH
  clientId   String
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  client McpClient @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([userId])
}

// ───────────────────────────── Tags das creators (M4.2, D-TAGS) ─────────────────────────────

/// Tag livre da marca, criada pela Gestão (ex.: "fitness", "mãe"). `key` = nome sem acento e minúsculo (não repete).
model CreatorTag {
  id          String   @id @default(uuid())
  brandId     String
  name        String
  key         String
  createdAt   DateTime @default(now())
  createdById String

  brand Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  links CreatorTagLink[]

  @@unique([brandId, key])
  @@unique([id, brandId])
}

/// Tag marcada numa creator (mesma marca da tag e da creator, pela chave composta).
model CreatorTagLink {
  creatorId   String
  tagId       String
  brandId     String
  createdAt   DateTime @default(now())
  createdById String

  creator Creator    @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  tag     CreatorTag @relation(fields: [tagId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([creatorId, tagId])
  @@index([tagId])
}

// ───────────────────────────── Imagens da marca (M4.4a, D-BRANDLOGIN) ─────────────────────────────

/// Logo da tela de entrar da marca (fundo liso). Guardado no banco (até 300 KB); só PNG, JPG ou WebP (conferido pelos
/// bytes). Trocar substitui; tirar apaga (não é dado financeiro).
model BrandAsset {
  id           String   @id @default(uuid())
  brandId      String
  kind         String // LOGO
  mime         String
  bytes        Bytes
  sizeBytes    Int
  sha256       String
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, kind])
}

// ───────────────────────────── Campanhas e desafios (M4.5, D-CAMPAIGN) ─────────────────────────────

/// Campanha da marca para as creators: briefing, período (dias em São Paulo), público (tipos e tags; vazio = todas),
/// prêmios por posição no ranking de vendas e/ou por meta individual. Rascunho até publicar; prêmios confirmados uma
/// vez (`settledAt`), a partir de 7 dias depois do fim.
model Campaign {
  id             String            @id @default(uuid())
  brandId        String
  name           String
  briefing       String
  startDay       String // AAAA-MM-DD (São Paulo)
  endDay         String // AAAA-MM-DD (inclusive)
  startsAt       DateTime
  endsAt         DateTime // exclusivo: 00:00 do dia seguinte ao fim
  categories     CreatorCategory[]
  tagIds         String[]
  rankingPrizes  Int[] // centavos por posição (1º, 2º…)
  goalCents      Int?
  goalPrizeCents Int?
  allianceOsUrl  String?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  publishedAt    DateTime?
  settledAt      DateTime?
  settledById    String?

  brand   Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  entries CampaignEntry[]
  prizes  CampaignPrize[]
  posts   CreatorPost[]

  @@unique([id, brandId])
  @@index([brandId, startsAt])
}

/// Inscrição da creator na campanha ("Quero participar").
model CampaignEntry {
  campaignId String
  creatorId  String
  brandId    String
  joinedAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId, brandId], references: [id, brandId], onDelete: Restrict)
  creator  Creator  @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@id([campaignId, creatorId])
}

/// Prêmio confirmado: uma linha por creator e motivo (posição ou meta), com o lançamento no extrato.
model CampaignPrize {
  id            String   @id @default(uuid())
  campaignId    String
  creatorId     String
  brandId       String
  kind          String // RANK | GOAL
  position      Int?
  salesCents    Int
  amountCents   Int
  ledgerEntryId String   @unique
  createdById   String
  createdAt     DateTime @default(now())

  campaign    Campaign    @relation(fields: [campaignId, brandId], references: [id, brandId], onDelete: Restrict)
  creator     Creator     @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  brand       Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  ledgerEntry LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@unique([campaignId, creatorId, kind])
}

// ───────────────────────────── Posts das creators (M4.6, D-POSTS) ─────────────────────────────

/// Post da creator (link e dia em que postou), registrado por ela no portal ou pela equipe na ficha; pode ser de uma
/// campanha em que ela está inscrita. Tirar = `removedAt` (fica na auditoria).
model CreatorPost {
  id          String    @id @default(uuid())
  brandId     String
  creatorId   String
  url         String
  platform    String // INSTAGRAM | TIKTOK | YOUTUBE | KWAI | OUTRO
  postedDay   String // AAAA-MM-DD (São Paulo)
  campaignId  String?
  createdById String
  byStaff     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  removedAt   DateTime?
  removedById String?

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator  Creator   @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  campaign Campaign? @relation(fields: [campaignId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([brandId, postedDay])
  @@index([creatorId, postedDay])
}

/// U6 (D-PROSPECT): situação da abordagem antes do formulário (as da aba "Prospecção Hunter" + Inscrita).
enum ProspectStatus {
  FIRST_MESSAGE
  FOLLOW_UP
  FORM_SENT
  SIGNED_UP
  DECLINED
}

/// U6 (D-PROSPECT): perfil abordado por alguém da marca (Gestão ou hunter), antes de se inscrever. Um @ por marca.
model Prospect {
  id            String         @id @default(uuid())
  brandId       String
  /// @ do Instagram, sem "@", em minúsculas.
  handle        String
  ownerId       String
  approachedOn  DateTime       @db.Date
  status        ProspectStatus @default(FIRST_MESSAGE)
  statusAt      DateTime
  note          String?
  applicationId String?
  source        String         @default("manual") // manual | sheet_import
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  brand       Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  application CreatorApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([brandId, handle])
  @@index([brandId, ownerId])
}
