// Creator Club v2 — schema do núcleo (lançamento 1).
//
// Regras que valem para todo o schema:
//  - Dinheiro em centavos (Int) e taxas em pontos-base (1500 = 15%). Nunca Float.
//  - Nada financeiro é apagado: relações com onDelete: Restrict; status no lugar de exclusão.
//  - Tudo que pertence a uma marca carrega brandId. Relações financeiras usam FK composta
//    (id, brandId) para impedir misturar registros de marcas diferentes.
//  - Travas que o Prisma não expressa (CHECKs, exclusão de sobreposição, extrato só de
//    inserção, um saque aberto por creator, unicidade com NULL) estão em SQL na migração
//    prisma/migrations/*_core/migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Marca e integrações ─────────────────────────────

model Brand {
  id                        String    @id @default(uuid())
  slug                      String    @unique
  name                      String
  enabled                   Boolean   @default(false)
  timezone                  String    @default("America/Sao_Paulo")
  currency                  String    @default("BRL")
  storeUrl                  String?
  primaryColor              String    @default("#18181B") // D-BRANDCOLOR; só #RRGGBB (Brand_colors_hex)
  secondaryColor            String?
  defaultCommissionBps      Int       @default(1500) // DECISÃO-ABERTA: D-RATE
  defaultDiscountBps        Int       @default(500)
  withdrawalMinCents        Int       @default(1) // D-CONTRACT: sem mínimo por pedido (o mínimo é de vendas no mês)
  withdrawalWindowStartDay  Int       @default(1) // D-CONTRACT: NF do dia 1 ao 10, pagamento até o dia 15
  withdrawalWindowEndDay    Int       @default(10)
  commissionHoldDays        Int       @default(7) // só informativo desde D-CONTRACT (a liberação é no fechamento do mês)
  /// D-CONTRACT: vendas acumuladas mínimas para liberar a comissão no fechamento do mês.
  releaseMinCents           Int       @default(50000)
  releaseMinPrescriberCents Int       @default(100000)
  nfInstructions            String?
  nfTakerDocument           String? // D-NF: CNPJ do tomador da nota fiscal da creator
  legalName                 String? // razão social (recibo de pessoa física, D-PFRECEIPT)
  legacyId                  String?   @unique
  /// D-ARCHIVE: marca arquivada some de todas as telas (nada é apagado).
  archivedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  integrations       BrandIntegration[]
  roleGrants         RoleGrant[]
  staffInvites       StaffInvite[]
  creators           Creator[]
  commissionPolicies CommissionPolicy[]
  coupons            Coupon[]
  couponAssignments  CouponAssignment[]
  orders             Order[]
  orderLines         OrderLine[]
  attributions       OrderAttribution[]
  ledgerEntries      LedgerEntry[]
  withdrawals        Withdrawal[]
  files              File[]
  webhookEvents      WebhookEvent[]
  jobs               Job[]
  syncRuns           SyncRun[]
  auditLogs          AuditLog[]
  clicks             Click[]
  products           Product[]
  shipments          Shipment[]
  termsVersions      TermsVersion[]
  applications       CreatorApplication[]
  termsAcceptances   TermsAcceptance[]
  contractDocuments  ContractDocument[]
  contractSignatures ContractSignature[]
  commissionReleases CommissionRelease[]
  monthClosings      MonthClosing[]
  legacyPayments     LegacyPayment[]
  contractTemplates  ContractTemplate[]
  kitGrants          KitGrant[]
  hunterLinks        HunterLink[]
  hunterClicks       HunterClick[]
  formLinks          FormLink[]
  ugcVideos          UgcVideo[]
}

enum IntegrationKind {
  SHOPIFY
  AUTENTIQUE
  WHATSAPP
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

/// Credenciais por marca. Segredos sempre cifrados pela aplicação (AES-256-GCM) com chave fora do banco.
model BrandIntegration {
  id              String            @id @default(uuid())
  brandId         String
  kind            IntegrationKind
  status          IntegrationStatus @default(DISCONNECTED)
  externalId      String? // ex.: botanika-brasil.myshopify.com
  secretEncrypted String?
  scopes          String?
  apiVersion      String?
  lastSyncAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, kind])
}

// ───────────────────────────── Pessoas e acesso ─────────────────────────────

/// Pessoa que faz login (equipe ou creator). id = id do usuário no Supabase Auth.
model User {
  id         String    @id
  email      String    @unique
  name       String
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  roleGrants     RoleGrant[]
  creatorAccount CreatorAccount?
  hunterLinks    HunterLink[]
}

enum StaffRole {
  SUPER_ADMIN
  GESTAO
  ENVIO
  PAGAMENTO
  HUNTER
}

/// Papel de alguém da equipe numa marca. brandId nulo = todas as marcas (só SUPER_ADMIN).
/// Papel global (brandId nulo) único por pessoa: índice parcial na migração.
model RoleGrant {
  id        String    @id @default(uuid())
  userId    String
  brandId   String?
  role      StaffRole
  createdAt DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([userId, brandId, role])
  @@index([userId])
}

/// Convite de uso único para a equipe (E2.4). Só o hash do token fica no banco; o link é mostrado uma vez.
model StaffInvite {
  id             String    @id @default(uuid())
  email          String
  name           String
  role           StaffRole
  brandId        String? // nulo só para SUPER_ADMIN
  tokenHash      String    @unique
  expiresAt      DateTime
  createdById    String
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  /// D-EMAIL: quando o convite foi enviado por e-mail (nulo = só o link na tela).
  emailedAt      DateTime?
  createdAt      DateTime  @default(now())

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([email])
}

/// Dados da pessoa creator, únicos para todas as marcas.
model CreatorAccount {
  id             String   @id @default(uuid())
  userId         String?  @unique // preenchido quando o convite é aceito
  name           String
  email          String   @unique
  phone          String?
  cpf            String?
  cnpj           String?
  pixKey         String?
  instagram      String? // sem o @
  /// Endereço de entrega (D-SHIPADDR): a creator mantém no portal; cada envio guarda uma cópia.
  addrZip        String?
  addrStreet     String?
  addrNumber     String?
  addrComplement String?
  addrDistrict   String?
  addrCity       String?
  addrState      String?
  legacyId       String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  creators Creator[]
  invites  CreatorInvite[]
}

/// Convite de uso único para a creator entrar no portal (E2.5). Ligado à conta, nunca ao e-mail solto.
model CreatorInvite {
  id             String    @id @default(uuid())
  accountId      String
  tokenHash      String    @unique
  expiresAt      DateTime
  createdById    String
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  /// D-EMAIL: quando o convite foi enviado por e-mail (nulo = só o link na tela).
  emailedAt      DateTime?
  createdAt      DateTime  @default(now())

  account CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
}

enum CreatorCategory {
  INFLUENCER
  UGC
  PRESCRITOR
}

enum CreatorStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
}

/// Participação de uma pessoa numa marca.
model Creator {
  id                      String            @id @default(uuid())
  brandId                 String
  accountId               String
  categories              CreatorCategory[]
  status                  CreatorStatus     @default(ACTIVE)
  activatedAt             DateTime?
  deactivatedAt           DateTime?
  /// D-WDLOCK: saque liberado depois do saldo de abertura aprovado (E6). Nulo = travado.
  withdrawalsUnlockedAt   DateTime?
  withdrawalsUnlockedById String?
  /// D-PFRECEIPT: recebe como pessoa física (recibo no lugar da nota); a equipe marca na ficha.
  receivesAsIndividual    Boolean           @default(false)
  /// D-ANAREVIEW: a Ana conferiu os números (cupons, taxa, vendas) desta creator. Exigido para o saldo de abertura (E6).
  reviewedAt              DateTime?
  reviewedById            String?
  source                  String? // hunter | site | instagram | legacy_import | central
  legacyId                String?
  /// D-CONTRACTVER: modelo de contrato que a creator assinou (mínimo de vendas, faixas de kit, prazo).
  contractTemplateId      String?
  /// D-SIGNCONTRACT: creator aprovada em Candidatas precisa assinar o contrato no portal (o portal fica travado até lá).
  contractRequiredAt      DateTime?
  /// D-CHECKLIST: contrato (vigência; aviso 30 dias antes e no fim, nunca desliga sozinho) e checklist da Central.
  /// Booleano nulo = não informado.
  contractStart           DateTime?         @db.Date
  contractEnd             DateTime?         @db.Date
  contractSigned          Boolean?
  couponRegistered        Boolean?
  followsOnInstagram      Boolean?
  inGroup                 Boolean?
  tagged                  Boolean?
  checklistNote           String?
  /// UGC (até o módulo UGC): pasta dos vídeos, situação dos vídeos e o que foi pedido.
  ugcFolderUrl            String?
  ugcVideoStatus          String?
  ugcOrder                String?
  /// D-UGCVIDEOS: meta de vídeos no ciclo (= período do contrato), definida por creator na ficha.
  ugcVideoGoal            Int?
  notes                   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  account            CreatorAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  commissionPolicies CommissionPolicy[]
  couponAssignments  CouponAssignment[]
  attributions       OrderAttribution[]
  ledgerEntries      LedgerEntry[]
  withdrawals        Withdrawal[]
  shipments          Shipment[]
  termsAcceptances   TermsAcceptance[]
  contractSignatures ContractSignature[]
  commissionReleases CommissionRelease[]
  legacyPayments     LegacyPayment[]
  kitGrants          KitGrant[]
  ugcVideos          UgcVideo[]
  contractTemplate   ContractTemplate?   @relation(fields: [contractTemplateId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([brandId, accountId])
  @@unique([id, brandId])
  @@unique([brandId, legacyId])
  @@index([brandId, status])
}

/// Taxa de comissão com vigência [validFrom, validTo). Sem sobreposição por creator (EXCLUDE na migração).
model CommissionPolicy {
  id            String    @id @default(uuid())
  brandId       String
  creatorId     String
  rateBps       Int
  validFrom     DateTime
  validTo       DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  /// Taxa confirmada pela Ana (D-RATEIMPORT). Sem confirmação, nunca entra em cálculo.
  confirmedAt   DateTime?
  confirmedById String?

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([creatorId, validFrom])
}

// ───────────────────────────── Cupons ─────────────────────────────

enum CouponKind {
  CREATOR
  PROMO
}

/// Todo cupom conhecido da marca. O código é único por marca; a dona muda por CouponAssignment.
model Coupon {
  id             String      @id @default(uuid())
  brandId        String
  code           String // sempre em maiúsculas
  /// null = ainda não classificado pela Ana (D-CLASS); nunca atribui enquanto for null.
  kind           CouponKind?
  classifiedAt   DateTime?
  classifiedById String?
  shopifyId      String?
  discountBps    Int?
  active         Boolean     @default(true)
  legacyId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  brand        Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  assignments  CouponAssignment[]
  attributions OrderAttribution[]
  clicks       Click[]

  @@unique([brandId, code])
  @@unique([id, brandId])
}

/// De quem é um cupom CREATOR em cada período [validFrom, validTo). Sem sobreposição (EXCLUDE na migração).
model CouponAssignment {
  id            String    @id @default(uuid())
  brandId       String
  couponId      String
  creatorId     String
  validFrom     DateTime
  validTo       DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  /// Dona confirmada pela Ana (D-RATEIMPORT). Sem confirmação, o pedido fica pendente.
  confirmedAt   DateTime?
  confirmedById String?

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  coupon  Coupon  @relation(fields: [couponId, brandId], references: [id, brandId], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([couponId, validFrom])
  @@index([creatorId])
}

// ───────────────────────────── Pedidos ─────────────────────────────

/// Espelho do pedido do Shopify. Todos os pedidos da loja, com poucos campos.
model Order {
  id               String    @id @default(uuid())
  brandId          String
  shopifyId        String // gid://shopify/Order/…
  name             String // #1234
  createdAtShop    DateTime
  paidAt           DateTime?
  cancelledAt      DateTime?
  financialStatus  String
  test             Boolean   @default(false)
  taxesIncluded    Boolean?
  subtotalCents    Int // currentSubtotalPriceSet: produtos, com descontos e reembolsos, sem frete
  totalCents       Int
  currency         String    @default("BRL")
  discountCodes    String[]
  shopifyUpdatedAt DateTime // versão desta foto do pedido
  syncedAt         DateTime  @default(now())

  brand         Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  lines         OrderLine[]
  attribution   OrderAttribution?
  ledgerEntries LedgerEntry[]

  @@unique([brandId, shopifyId])
  @@unique([id, brandId])
  @@index([brandId, shopifyUpdatedAt])
  @@index([brandId, createdAtShop])
}

model OrderLine {
  id                   String @id @default(uuid())
  brandId              String
  orderId              String
  shopifyId            String
  title                String
  quantity             Int
  discountedTotalCents Int

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([orderId, shopifyId])
}

/// A qual creator o pedido pertence. Decidida uma vez (regra first_creator_code_v1).
/// rateBps é preenchido quando o pedido é pago (taxa vigente no pagamento) e não muda depois.
model OrderAttribution {
  id            String   @id @default(uuid())
  brandId       String
  orderId       String   @unique
  creatorId     String
  couponId      String
  rateBps       Int?
  rule          String
  evidenceCodes String[]
  decidedAt     DateTime @default(now())

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  coupon  Coupon  @relation(fields: [couponId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([orderId, brandId])
  @@index([brandId, creatorId])
}

// ───────────────────────────── Extrato e saques ─────────────────────────────

enum LedgerType {
  COMMISSION
  REVERSAL
  WITHDRAWAL
  ADJUSTMENT
  OPENING_BALANCE
}

/// Cada centavo que entra ou sai do saldo. Só recebe inserções (trigger na migração).
model LedgerEntry {
  id             String     @id @default(uuid())
  brandId        String
  creatorId      String
  type           LedgerType
  amountCents    Int // com sinal
  orderId        String?
  withdrawalId   String?
  baseCents      Int?
  rateBps        Int?
  availableAt    DateTime
  idempotencyKey String     @unique
  note           String?
  createdById    String?
  createdAt      DateTime   @default(now())

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator    Creator     @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  order      Order?      @relation(fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)
  withdrawal Withdrawal? @relation(fields: [withdrawalId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([brandId, creatorId, createdAt])
  @@index([orderId])
}

enum PaymentMethod {
  NF_PIX
  ALELO
  RECEIPT_PIX // D-PFRECEIPT: pessoa física, recibo aceito no portal + Pix
}

enum NfCheckStatus {
  OK
  MANUAL
}

enum WithdrawalStatus {
  REQUESTED
  PAID
  REJECTED
  CANCELLED
}

/// Pedido de saque. No máximo um REQUESTED por creator (índice parcial na migração).
model Withdrawal {
  id             String           @id @default(uuid())
  brandId        String
  creatorId      String
  amountCents    Int
  method         PaymentMethod    @default(NF_PIX)
  status         WithdrawalStatus @default(REQUESTED)
  nfFileId       String?
  nfAccessKey    String? // D-NFCHECK: chave de acesso da NFS-e (50 dígitos); uma nota vale para um saque só
  nfCheck        NfCheckStatus? // D-NFCHECK: OK = conferida pelo sistema; MANUAL = o Pagamento confere
  idempotencyKey String           @unique
  requestedAt    DateTime         @default(now())
  decidedAt      DateTime?
  decidedById    String?
  note           String?

  brand         Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator       Creator            @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  nfFile        File?              @relation(fields: [nfFileId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]
  receipt       WithdrawalReceipt?

  @@unique([id, brandId])
  @@index([brandId, status])
  @@index([creatorId])
}

/// D-PFRECEIPT: recibo da creator pessoa física, aceito no portal no lugar da nota. Só recebe inserções.
model WithdrawalReceipt {
  id           String   @id @default(uuid())
  brandId      String
  withdrawalId String   @unique
  userId       String
  fullName     String
  cpf          String
  body         String // texto do recibo como a creator viu
  ip           String?
  userAgent    String?
  acceptedAt   DateTime @default(now())

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
}

/// Arquivo no Storage privado (NF, contrato, vídeo UGC).
model File {
  id           String   @id @default(uuid())
  brandId      String
  bucket       String
  path         String
  mime         String
  sizeBytes    Int
  sha256       String
  uploadedById String?
  createdAt    DateTime @default(now())

  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  withdrawals Withdrawal[]

  @@unique([bucket, path])
}

// ───────────────────────────── Operação ─────────────────────────────

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

/// Todo webhook recebido, gravado antes de responder. X-Shopify-Webhook-Id repetido é ignorado.
model WebhookEvent {
  id          String        @id @default(uuid())
  brandId     String
  topic       String
  webhookId   String
  resourceId  String?
  payloadHash String
  status      WebhookStatus @default(RECEIVED)
  attempts    Int           @default(0)
  error       String?
  receivedAt  DateTime      @default(now())
  processedAt DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, webhookId])
  @@index([status, receivedAt])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Fila de trabalho no Postgres (o webhook grava evento + job na mesma transação).
model Job {
  id          String    @id @default(uuid())
  brandId     String?
  type        String
  payload     Json
  dedupeKey   String?   @unique
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(8)
  runAt       DateTime  @default(now())
  lockedUntil DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([status, runAt])
}

/// Histórico de cargas e reconciliações com o Shopify.
model SyncRun {
  id          String    @id @default(uuid())
  brandId     String
  kind        String // incremental | nightly | backfill
  cursor      DateTime?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  ordersSeen  Int       @default(0)
  ordersFixed Int       @default(0)
  error       String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId, startedAt])
}

enum ActorType {
  USER
  SYSTEM
  WEBHOOK
  JOB
}

/// Quem mudou o quê. Só recebe inserções (trigger na migração).
model AuditLog {
  id        String    @id @default(uuid())
  brandId   String?
  actorType ActorType
  actorId   String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime  @default(now())

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId, createdAt])
  @@index([entity, entityId])
}

/// Clique no link de afiliado /r/<marca>/<cupom>.
model Click {
  id        String   @id @default(uuid())
  brandId   String
  couponId  String
  ipHash    String?
  userAgent String?
  referrer  String?
  landing   String?
  createdAt DateTime @default(now())

  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  coupon Coupon @relation(fields: [couponId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([couponId, createdAt])
}

// ───────────────────────────── Envios de produtos à creator (E7.8) ─────────────────────────────

/// Produto da loja (catálogo da Shopify), para escolher o que vai em cada envio.
model Product {
  id        String   @id @default(uuid())
  brandId   String
  shopifyId String
  title     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  items ShipmentItem[]

  @@unique([brandId, shopifyId])
  @@unique([id, brandId])
}

enum ShipmentStatus {
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Envio de produtos à creator (D-SHIPMENTS). Endereço copiado no momento do envio; situação com datas coerentes
/// (travas na migração). Nada é apagado: cancelar é situação.
model Shipment {
  id            String         @id @default(uuid())
  brandId       String
  creatorId     String
  status        ShipmentStatus @default(PREPARING)
  note          String?
  address       Json
  carrier       String?
  trackingCode  String?
  createdById   String
  shippedAt     DateTime?
  shippedById   String?
  deliveredAt   DateTime?
  deliveredBy   String? // STAFF | CREATOR
  deliveredById String?
  cancelledAt   DateTime?
  cancelledById String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  brand   Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator        @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  items   ShipmentItem[]
  kit     KitGrant?

  @@unique([id, brandId])
  @@index([brandId, status, createdAt])
  @@index([creatorId, createdAt])
}

model ShipmentItem {
  id         String @id @default(uuid())
  brandId    String
  shipmentId String
  productId  String
  title      String // cópia do nome do produto no envio
  quantity   Int

  shipment Shipment @relation(fields: [shipmentId, brandId], references: [id, brandId], onDelete: Restrict)
  product  Product  @relation(fields: [productId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([shipmentId])
}

// ───────────────────────────── Termo de aceite da creator (P4) ─────────────────────────────

/// Texto do termo por marca, em versões (D-TERMS). Só recebe inserções; texto novo = versão nova = novo aceite.
model TermsVersion {
  id          String   @id @default(uuid())
  brandId     String
  version     Int
  title       String
  body        String
  createdById String
  createdAt   DateTime @default(now())

  brand       Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  acceptances TermsAcceptance[]

  @@unique([brandId, version])
  @@unique([id, brandId])
}

/// Aceite eletrônico do termo: quem, quando, de onde, com nome e CPF digitados. Só recebe inserções.
model TermsAcceptance {
  id             String   @id @default(uuid())
  brandId        String
  creatorId      String
  termsVersionId String
  userId         String
  fullName       String
  cpf            String
  ip             String?
  userAgent      String?
  acceptedAt     DateTime @default(now())

  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator      Creator      @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  termsVersion TermsVersion @relation(fields: [termsVersionId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([creatorId, termsVersionId])
  @@index([termsVersionId])
}

// ───────────────────────────── Candidatas (formulário Hunter) ─────────────────────────────

enum ApplicationStatus {
  NEW
  APPROVED
  REJECTED
}

/// Resposta do formulário de cadastro (D-ONBOARD). Chega pelo script do Google Forms; a equipe aprova (vira creator,
/// cupom, taxa e convite) ou recusa. A resposta original fica em `raw`.
model CreatorApplication {
  id              String            @id @default(uuid())
  brandId         String
  source          String // hunter_form | captacao_form (D-CAPTACAO)
  externalKey     String // id da resposta no Google Forms
  submittedAt     DateTime
  fullName        String
  email           String?
  phone           String?
  instagram       String?
  followers       String?
  niche           String?
  kindAnswer      String? // resposta do "Sou:"
  address         String?
  suggestedCoupon String?
  cpf             String?
  cnpj            String?
  companyName     String?
  pixKey          String?
  storiesViews    String? // D-CAPTACAO: "Quantos visualizações tem seus stories?"
  brandsWanted    String? // D-CAPTACAO: "Tenho interesse em representar:" (Botanika / Botanika e VermeFree)
  collabInterest  String? // D-CAPTACAO: interesse em collab com o perfil da marca (Sim/Não)
  note            String? // observação da equipe (ex.: status da planilha antiga)
  hunterCode      String? // D-HUNTERLINK: "Código de quem te convidou" (vem pré-preenchido pelo link do hunter)
  hunterLinkId    String?
  /// D-SIGNUP: inscrição pelo formulário do próprio sistema — quando aceitou o uso dos dados e hash do IP do dia
  /// (só para limitar envios repetidos; o IP em si nunca é gravado).
  consentAt       DateTime?
  ipHash          String?
  raw             Json
  status          ApplicationStatus @default(NEW)
  decidedAt       DateTime?
  decidedById     String?
  decisionNote    String?
  creatorId       String?
  createdAt       DateTime          @default(now())

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  hunterLink HunterLink? @relation(fields: [hunterLinkId], references: [id], onDelete: Restrict)

  @@unique([brandId, source, externalKey])
  @@index([brandId, status, submittedAt])
}

/// D-CONTRACT: liberação da comissão no fechamento do mês. Comissões de pedidos pagos até `month` (inclusive) ficam
/// disponíveis para saque. Só é gravada quando as vendas acumuladas desde a liberação anterior atingem o mínimo.
/// Somente inserção.
model CommissionRelease {
  id         String   @id @default(uuid())
  brandId    String
  creatorId  String
  month      String // AAAA-MM
  salesCents Int // vendas acumuladas desde a liberação anterior até `month`
  minCents   Int // mínimo vigente no fechamento
  releasedAt DateTime @default(now())

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([creatorId, month])
  @@index([brandId, month])
}

/// D-CONTRACT: fechamento do mês de uma marca já rodado (o worker não refaz).
model MonthClosing {
  id       String   @id @default(uuid())
  brandId  String
  month    String // AAAA-MM
  releases Int
  closedAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, month])
}

/// D-LEGACYPAY: pagamento feito antes do Creator Club, importado da planilha da equipe ("Pagamentos influencers").
/// Só valores (sem Pix nem documento). Serve de evidência e sugere o "já pago" do saldo de abertura. Somente inserção.
model LegacyPayment {
  id           String   @id @default(uuid())
  brandId      String
  creatorId    String
  month        String // AAAA-MM das vendas pagas
  periodLabel  String // como a planilha chama o período (ex.: "23/06 a 31/07")
  salesCents   Int
  rateBps      Int
  amountCents  Int
  source       String // ex.: "planilha-pagamentos"
  sourceRef    String // aba e linha da planilha
  importedAt   DateTime @default(now())
  importedById String

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([brandId, source, sourceRef])
  @@index([creatorId])
}

/// D-CONTRACTVER: versão de contrato de uma marca. Cada creator segue a versão que assinou: mínimo de vendas no mês
/// para liberar a comissão (nulo = sem comissão, ex.: UGC permuta), faixas do kit mensal e prazo.
model ContractTemplate {
  id              String   @id @default(uuid())
  brandId         String
  key             String // ex.: influencer-2026-09
  name            String
  releaseMinCents Int?
  /// Faixas do kit pelas vendas do mês anterior: [{ fromCents, toCents?, products }], em ordem crescente.
  kitTiers        Json     @default("[]")
  months          Int
  /// D-SIGNCONTRACT: qual texto de contrato esta versão usa (INFLUENCER, PRESCRITOR ou UGC).
  documentKind    String   @default("INFLUENCER")
  /// D-WELCOMEKIT: suplementos do início da parceria (escolhidos no portal depois de assinar); 0 = sem kit.
  welcomeProducts Int      @default(0)
  createdAt       DateTime @default(now())

  brand      Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creators   Creator[]
  signatures ContractSignature[]

  @@unique([brandId, key])
  @@unique([id, brandId])
}

enum KitStatus {
  PENDING // aguardando a creator escolher os produtos
  CHOSEN // envio criado
}

/// D-KIT: kit mensal do contrato. No fechamento do mês, a faixa de vendas do mês (contrato da creator) dá N
/// suplementos; a creator escolhe os produtos no portal e o envio é criado "Preparando". Sem prazo.
model KitGrant {
  id         String    @id @default(uuid())
  brandId    String
  creatorId  String
  /// MONTHLY = kit do mês pelas vendas (D-KIT); WELCOME = kit de boas-vindas do contrato, ao assinar (D-WELCOMEKIT).
  kind       String    @default("MONTHLY")
  month      String // AAAA-MM das vendas (boas-vindas: mês da assinatura)
  salesCents Int
  products   Int
  status     KitStatus @default(PENDING)
  shipmentId String?   @unique
  chosenAt   DateTime?
  createdAt  DateTime  @default(now())

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator  Creator   @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([creatorId, kind, month])
  @@index([brandId, status])
}

// ───────────────────────────── Links dos hunters (D-HUNTERLINK) ─────────────────────────────

/// Link de um hunter na marca: `/f/[marca]/[formulario]/[codigo]` abre o formulário com "Código de quem te convidou"
/// pré-preenchido; a candidata chega marcada com quem a trouxe. O código não muda (links já divulgados).
model HunterLink {
  id        String   @id @default(uuid())
  brandId   String
  userId    String
  code      String // só letras minúsculas e números
  createdAt DateTime @default(now())

  brand        Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  clicks       HunterClick[]
  applications CreatorApplication[]

  @@unique([brandId, code])
  @@unique([brandId, userId])
}

/// Clique no link do hunter (só recebe inserções). IP guardado só como hash do dia.
model HunterClick {
  id           String   @id @default(uuid())
  brandId      String
  hunterLinkId String
  form         String // hunter | captacao
  ipHash       String?
  userAgent    String?
  createdAt    DateTime @default(now())

  brand      Brand      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  hunterLink HunterLink @relation(fields: [hunterLinkId], references: [id], onDelete: Restrict)

  @@index([hunterLinkId, createdAt])
}

/// Link pré-preenchido do Google Forms de cada formulário da marca, com CODIGO no lugar do código do hunter.
model FormLink {
  id          String   @id @default(uuid())
  brandId     String
  form        String // hunter | captacao
  urlTemplate String
  updatedById String
  updatedAt   DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, form])
}

/// Vídeo entregue por uma UGC (D-UGCVIDEOS): um registro por vídeo, com o link. Conta na meta do ciclo (período do
/// contrato) pela data de entrega. Nada é apagado: registro errado é retirado (removedAt) e sai da contagem.
model UgcVideo {
  id          String    @id @default(uuid())
  brandId     String
  creatorId   String
  deliveredOn DateTime  @db.Date
  url         String
  product     String?
  createdById String
  createdAt   DateTime  @default(now())
  removedAt   DateTime?
  removedById String?

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([creatorId, deliveredOn])
}

/// D-SIGNCONTRACT: texto do contrato por marca e tipo (INFLUENCER, PRESCRITOR, UGC), em versões que só recebem
/// inserções. Os campos entre chaves duplas ({{NOME}}, {{CUPOM}}...) são preenchidos com os dados de cada creator.
model ContractDocument {
  id          String   @id @default(uuid())
  brandId     String
  kind        String
  version     Int
  title       String
  body        String
  createdById String
  createdAt   DateTime @default(now())

  brand      Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  signatures ContractSignature[]

  @@unique([brandId, kind, version])
  @@unique([id, brandId])
}

/// Assinatura eletrônica do contrato no portal: o texto preenchido exatamente como foi assinado (e o hash dele),
/// com os dados digitados, data, IP e navegador. Só recebe inserções.
model ContractSignature {
  id                 String   @id @default(uuid())
  brandId            String
  creatorId          String
  contractDocumentId String
  contractTemplateId String
  userId             String
  fullName           String
  cpf                String
  cnpj               String?
  companyName        String?
  address            String
  body               String
  bodySha256         String
  ip                 String?
  userAgent          String?
  signedAt           DateTime @default(now())

  brand            Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator          Creator          @relation(fields: [creatorId, brandId], references: [id, brandId], onDelete: Restrict)
  contractDocument ContractDocument @relation(fields: [contractDocumentId, brandId], references: [id, brandId], onDelete: Restrict)
  contractTemplate ContractTemplate @relation(fields: [contractTemplateId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([creatorId, contractDocumentId])
  @@index([contractDocumentId])
}
